#!/bin/bash
# mirabelle: run Claude in a container, per project folder, behind a firewall.
#
# This file only finds its folders and loads lib/. Every command is in lib/.
# Layout: ~/mirabelle/plumbing/bin/mirabelle  ->  plumbing = ~/mirabelle/plumbing,
#                                                 root     = ~/mirabelle
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
MB_PLUMBING=$(dirname "$(dirname "$self")")
MB_ROOT=$(dirname "$MB_PLUMBING")

for f in "$MB_PLUMBING"/lib/*.sh; do
  # shellcheck source=/dev/null
  source "$f"
done

main "$@"
exit $?
